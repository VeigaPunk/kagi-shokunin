+def inline_command(argv: list[str]) -> bool:
+    if not argv:
+        return False
+    for argument in argv[1:]:
+        if argv[0] == "python3" and argument == "-c":
+            return True
+        if (argv[0] == "bash" and argument.startswith("-")
+                and not argument.startswith("--") and "c" in argument[1:]):
+            return True
+    return False
+
