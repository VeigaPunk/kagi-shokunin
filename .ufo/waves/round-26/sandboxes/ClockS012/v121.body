\":\"line\"},mdx(\"span\",{parentName:\"span\"},`    groups_claim=\"https://vault/groups\" \\\\`)),`\n`,mdx(\"span\",{parentName:\"code\",\"className\":\"line\"},mdx(\"span\",{parentName:\"span\"},`    policies=webapps \\\\`)),`\n`,mdx(\"span\",{parentName:\"code\",\"className\":\"line\"},mdx(\"span\",{parentName:\"span\"},`    ttl=1h`)),`\n`)),mdx(\"p\",{parentName:\"li\"},`This role authorizes JWTs with the given subject and audience claims, gives\nit the `,mdx(\"inlineCode\",{parentName:\"p\"},`webapps`),` policy, and uses the given user/groups claims to set up\nIdentity aliases.`),mdx(\"p\",{parentName:\"li\"},`For the complete list of configuration options, please see the API\ndocumentation.`))),mdx(\"h3\",{\"id\":\"bound-claims\"},mdx(\"a\",{parentName:\"h3\",\"className\":\"__permalink-h\",\"href\":\"#bound-claims\",\"aria-label\":\"bound claims permalink\"},`\\xbb`),`Bound claims`),mdx(\"p\",null,`Once a JWT has been validated as being properly signed and not expired, the\nauthorization flow will validate that any configured \"bound\" parameters match.\nIn some cases there are dedicated parameters, for example `,mdx(\"inlineCode\",{parentName:\"p\"},`bound_subject`),`,\nthat must match the provided `,mdx(\"inlineCode\",{parentName:\"p\"},`sub`),` claim. For roles of type \"jwt\":`),mdx(\"ol\",null,mdx(\"li\",{parentName:\"ol\"},`the `,mdx(\"inlineCode\",{parentName:\"li\"},`bound_audiences`),` parameter is required when an `,mdx(\"inlineCode\",{parentName:\"li\"},`aud`),` claim is set.`),mdx(\"li\",{parentName:\"ol\"},`the `,mdx(\"inlineCode\",{parentName:\"li\"},`bound_audiences`),` parameter must `,mdx(\"strong\",{parentName:\"li\"},`exactly`),` match at least one of provided `,mdx(\"inlineCode\",{parentName:\"li\"},`aud`),` claims.`)),mdx(\"p\",null,`You can also configure roles to check an arbitrary set of claims and required\nvalues with the `,mdx(\"inlineCode\",{parentName:\"p\"},`bound_claims`),` map. For example, assume `,mdx(\"inlineCode\",{parentName:\"p\"},`bound_claims`),` is set to:`),mdx(\"pre\",{\"style\":{\"backgroundColor\":\"var(--code-block-color-surface-primary)\",\"color\":\"var(--code-block-color-token)\"},\"tabindex\":\"0\",\"language\":\"json\",\"className\":\"language-json\"},mdx(\"code\",{parentName:\"pre\",\"className\":\"language-json\"},mdx(\"span\",{parentName:\"code\",\"className\":\"line\"},mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-token)\"}},`{`)),`\n`,mdx(\"span\",{parentName:\"code\",\"className\":\"line\"},mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-keyword)\"}},`  \"division\"`),mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-punctuation)\"}},`:`),mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-string)\"}},` \"Europe\"`),mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-punctuation)\"}},`,`)),`\n`,mdx(\"span\",{parentName:\"code\",\"className\":\"line\"},mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-keyword)\"}},`  \"department\"`),mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-punctuation)\"}},`:`),mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-string)\"}},` \"Engineering\"`)),`\n`,mdx(\"span\",{parentName:\"code\",\"className\":\"line\"},mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-token)\"}},`}`)),`\n`)),mdx(\"p\",null,`Only JWTs containing both the \"division\" and \"department\" claims, and\nrespective matching values of \"Europe\" and \"Engineering\", would be authorized.\nIf the expected value is a list, the claim must match one of the items in the list.\nTo limit authorization to a set of email addresses:`),mdx(\"pre\",{\"style\":{\"backgroundColor\":\"var(--code-block-color-surface-primary)\",\"color\":\"var(--code-block-color-token)\"},\"tabindex\":\"0\",\"language\":\"json\",\"className\":\"language-json\"},mdx(\"code\",{parentName:\"pre\",\"className\":\"language-json\"},mdx(\"span\",{parentName:\"code\",\"className\":\"line\"},mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-token)\"}},`{`)),`\n`,mdx(\"span\",{parentName:\"code\",\"className\":\"line\"},mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-keyword)\"}},`  \"email\"`),mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-punctuation)\"}},`:`),mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-token)\"}},` [`),mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-string)\"}},`\"fred@example.com\"`),mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-punctuation)\"}},`,`),mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-string)\"}},` \"julie@example.com\"`),mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-token)\"}},`]`)),`\n`,mdx(\"span\",{parentName:\"code\",\"className\":\"line\"},mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-token)\"}},`}`)),`\n`)),mdx(\"p\",null,`Bound claims can optionally be configured with globs. See the `,mdx(\"a\",{parentName:\"p\",\"href\":\"/vault/api-docs/v1.21.x/auth/jwt#bound_claims_type\"},`API documentation`),` for more details.`),mdx(\"h3\",{\"id\":\"claims-as-metadata\"},mdx(\"a\",{parentName:\"h3\",\"className\":\"__permalink-h\",\"href\":\"#claims-as-metadata\",\"aria-label\":\"claims as metadata permalink\"},`\\xbb`),`Claims as metadata`),mdx(\"p\",null,`Data from claims can be copied into the resulting auth token and alias metadata by configuring `,mdx(\"inlineCode\",{parentName:\"p\"},`claim_mappings`),`. This role\nparameter is a map of items to copy. The map elements are of the form: `,mdx(\"inlineCode\",{parentName:\"p\"},`\"\u003cJWT claim\u003e\":\"\u003cmetadata key\u003e\"`),`. Assume\n`,mdx(\"inlineCode\",{parentName:\"p\"},`claim_mappings`),` is set to:`),mdx(\"pre\",{\"style\":{\"backgroundColor\":\"var(--code-block-color-surface-primary)\",\"color\":\"var(--code-block-color-token)\"},\"tabindex\":\"0\",\"language\":\"json\",\"className\":\"language-json\"},mdx(\"code\",{parentName:\"pre\",\"className\":\"language-json\"},mdx(\"span\",{parentName:\"code\",\"className\":\"line\"},mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-token)\"}},`{`)),`\n`,mdx(\"span\",{parentName:\"code\",\"className\":\"line\"},mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-keyword)\"}},`  \"division\"`),mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-punctuation)\"}},`:`),mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-string)\"}},` \"organization\"`),mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-punctuation)\"}},`,`)),`\n`,mdx(\"span\",{parentName:\"code\",\"className\":\"line\"},mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-keyword)\"}},`  \"department\"`),mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-punctuation)\"}},`:`),mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-string)\"}},` \"department\"`)),`\n`,mdx(\"span\",{parentName:\"code\",\"className\":\"line\"},mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-token)\"}},`}`)),`\n`)),mdx(\"p\",null,`This specifies that the value in the JWT claim \"division\" should be copied to the metadata key \"organization\". The JWT\n\"department\" claim value will also be copied into metadata but will retain the key name. If a claim is configured in `,mdx(\"inlineCode\",{parentName:\"p\"},`claim_mappings`),`,\nit must existing in the JWT or else the authentication will fail.`),mdx(\"p\",null,`Note: the metadata key name \"role\" is reserved and may not be used for claim mappings. Since Vault 1.16 the role name is available\nby the key `,mdx(\"inlineCode\",{parentName:\"p\"},`role`),` in the alias metadata of the entity after a successful login.`),mdx(\"h3\",{\"id\":\"claim-specifications-and-json-pointer\"},mdx(\"a\",{parentName:\"h3\",\"className\":\"__permalink-h\",\"href\":\"#claim-specifications-and-json-pointer\",\"aria-label\":\"claim specifications and json pointer permalink\"},`\\xbb`),`Claim specifications and JSON pointer`),mdx(\"p\",null,`Some parameters (e.g. `,mdx(\"inlineCode\",{parentName:\"p\"},`bound_claims`),`, `,mdx(\"inlineCode\",{parentName:\"p\"},`groups_claim`),`, `,mdx(\"inlineCode\",{parentName:\"p\"},`claim_mappings`),`, `,mdx(\"inlineCode\",{parentName:\"p\"},`user_claim`),`) are\nused to point to data within the JWT. If the desired key is at the top of level of the JWT,\nthe name can be provided directly. If it is nested at a lower level, a JSON Pointer may be\nused.`),mdx(\"p\",null,`Assume the following JSON data to be referenced:`),mdx(\"pre\",{\"style\":{\"backgroundColor\":\"var(--code-block-color-surface-primary)\",\"color\":\"var(--code-block-color-token)\"},\"tabindex\":\"0\",\"language\":\"json\",\"className\":\"language-json\"},mdx(\"code\",{parentName:\"pre\",\"className\":\"language-json\"},mdx(\"span\",{parentName:\"code\",\"className\":\"line\"},mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-token)\"}},`{`)),`\n`,mdx(\"span\",{parentName:\"code\",\"className\":\"line\"},mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-keyword)\"}},`  \"division\"`),mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-punctuation)\"}},`:`),mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-string)\"}},` \"North America\"`),mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-punctuation)\"}},`,`)),`\n`,mdx(\"span\",{parentName:\"code\",\"className\":\"line\"},mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-keyword)\"}},`  \"groups\"`),mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-punctuation)\"}},`:`),mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-token)\"}},` {`)),`\n`,mdx(\"span\",{parentName:\"code\",\"className\":\"line\"},mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-keyword)\"}},`    \"primary\"`),mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-punctuation)\"}},`:`),mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-string)\"}},` \"Engineering\"`),mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-punctuation)\"}},`,`)),`\n`,mdx(\"span\",{parentName:\"code\",\"className\":\"line\"},mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-keyword)\"}},`    \"secondary\"`),mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-punctuation)\"}},`:`),mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-string)\"}},` \"Software\"`)),`\n`,mdx(\"span\",{parentName:\"code\",\"className\":\"line\"},mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-token)\"}},`  }`)),`\n`,mdx(\"span\",{parentName:\"code\",\"className\":\"line\"},mdx(\"span\",{parentName:\"span\",\"style\":{\"color\":\"var(--code-block-color-token)\"}},`}`)),`\n`)),mdx(\"p\",null,`A parameter of `,mdx(\"inlineCode\",{parentName:\"p\"},`\"division\"`),` will reference \"North America\", as this is a top level key. A parameter\n`,mdx(\"inlineCode\",{parentName:\"p\"},`\"/groups/primary\"`),` uses JSON Pointer syntax to reference \"Engineering\" at a lower level. Any valid\nJSON Pointer can be used as a selector. Refer to the\n`,mdx(\"a\",{parentName:\"p\",\"href\":\"https://tools.ietf.org/html/rfc6901\"},`JSON Pointer RFC`),` for a full description of the syntax.`),mdx(\"h2\",{\"id\":\"tutorial\"},mdx(\"a\",{parentName:\"h2\",\"className\":\"__permalink-h\",\"href\":\"#tutorial\",\"aria-label\":\"tutorial permalink\"},`\\xbb`),`Tutorial`),mdx(\"p\",null,`Refer to the following tutorials for OIDC auth method usage examples:`),mdx(\"ul\",null,mdx(\"li\",{parentName:\"ul\"},mdx(\"a\",{parentName:\"li\",\"href\":\"/vault/tutorials/auth-methods/oidc-auth\"},`OIDC Auth Method`)),mdx(\"li\",{parentName:\"ul\"},mdx(\"a\",{parentName:\"li\",\"href\":\"/vault/tutorials/auth-methods/oidc-auth-azure\"},`Azure Active Directory with OIDC Auth Method and External\nGroups`)),mdx(\"li\",{parentName:\"ul\"},mdx(\"a\",{parentName:\"li\",\"href\":\"/vault/tutorials/auth-methods/vault-oidc-okta\"},`OIDC Authentication with Okta`)),mdx(\"li\",{parentName:\"ul\"},mdx(\"a\",{parentName:\"li\",\"href\":\"/vault/tutorials/auth-methods/google-workspace-oauth\"},`OIDC Authentication with Google Workspace`))),mdx(\"h2\",{\"id\":\"api\"},mdx(\"a\",{parentName:\"h2\",\"className\":\"__permalink-h\",\"href\":\"#api\",\"aria-label\":\"api permalink\"},`\\xbb`),`API`),mdx(\"p\",null,`The JWT Auth Plugin has a full HTTP API. Please see the\n`,mdx(\"a\",{parentName:\"p\",\"href\":\"/vault/api-docs/v1.21.x/auth/jwt\"},`API docs`),` for more details.`))};MDXContent.isMDXComponent=true;","scope":{"product":"vault","version":"v1.21.x"}},"product":{"name":"Vault","slug":"vault","version":"1.9.3","changelogUrl":null,"algoliaConfig":{"indexName":"product_VAULT","searchOnlyApiKey":"9c555e8fa951c1c53e726c0ce2eb3b73"},"analyticsConfig":{"includedDomains":"vaultproject.io www.vaultproject.io","segmentWriteKey":"OdSFDq9PfujQpmkZf03dFpcUlywme4sC"},"alertBannerActive":true,"alertBanner":{"tag":"HashiDays","url":"https://hashicorp.com/conferences/hashidays","text":"One conference. Three cities.","linkText":"Find a city near you","expirationDate":"2024-06-14T00:00:00-08:00"},"subnavItems":[{"text":"Overview","url":"/"},{"text":"Use Cases","submenu":[{"text":"Secrets Management","url":"/about-vault/why-use-vault/3rd-party-secrets"},{"text":"Data Encryption","url":"/about-vault/why-use-vault/sensitive-data"},{"text":"Identity-based Access","url":"/about-vault/why-use-vault/identity"}]},{"text":"Enterprise","url":"https://www.hashicorp.com/products/vault/enterprise"},"divider",{"text":"Tutorials","url":"https://developer.hashicorp.com/vault/tutorials"},{"text":"Docs","url":"/docs"},{"text":"API","url":"/api-docs"},{"text":"Agentic AI","url":"/ai"},{"text":"Community","url":"/community"}],"packageManagers":[{"label":"Homebrew","commands":["brew tap hashicorp/tap","brew install hashicorp/tap/vault"],"os":"darwin"},{"label":"Ubuntu/Debian","commands":["wget -O - https://apt.releases.hashicorp.com/gpg | sudo gpg --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg","echo \"deb [arch=amd64 signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main\" | sudo tee /etc/apt/sources.list.d/hashicorp.list","sudo apt-get update \u0026\u0026 sudo apt-get install vault"],"os":"linux"},{"label":"CentOS/RHEL","commands":["sudo yum install -y yum-utils","sudo yum-config-manager --add-repo https://rpm.releases.hashicorp.com/RHEL/hashicorp.repo","sudo yum -y install vault"],"os":"linux"},{"label":"Fedora","commands":["sudo dnf install -y dnf-plugins-core","sudo dnf config-manager addrepo --from-repofile=https://rpm.releases.hashicorp.com/fedora/hashicorp.repo","sudo dnf -y install vault"],"os":"linux"},{"label":"Amazon Linux","commands":["sudo yum install -y yum-utils","sudo yum-config-manager --add-repo https://rpm.releases.hashicorp.com/AmazonLinux/hashicorp.repo","sudo yum -y install vault"],"os":"linux"},{"label":"Homebrew","commands":["brew tap hashicorp/tap","brew install hashicorp/tap/vault"],"os":"linux"}],"basePaths":["docs","api-docs","ai","tutorials","downloads","cloud"],"rootDocsPaths":[{"iconName":"doc