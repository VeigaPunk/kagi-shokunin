  "quotes": [
    {
      "text": "Once a version has been fully released, bug fixes and security fixes are accepted. New binaries are built and released roughly every two months.",
      "section": "#status-key (bugfix)",
      "tokens": 24,
      "locate_count": 1
    },
    {
      "text": "This phase is also called maintenance mode or stable release.",
