+def receipt_date(value):
+    if not isinstance(value, str) or not value.endswith("Z"):
+        return None
+    try:
+        timestamp = dt.datetime.fromisoformat(value[:-1] + "+00:00")
+    except ValueError:
+        return None
+    if timestamp.utcoffset() != dt.timedelta(0):
+        return None
+    return timestamp.date().isoformat()
+
