+NUMERIC_VERSION_RE = re.compile(r"[0-9]+\.[0-9]+\.[0-9]+")
+
+
+def numeric_version(value):
+    """Strict X.Y.Z (optional leading v) as an int tuple, else None.
+
+    SemVer 2.0.0 §11.2: the release core compares numerically, so 1.10.0
+    sorts above 1.2.3. Two-component anchors and prerelease or build
+    suffixes are not ordered here; alone they keep the inequality rule,
+    a declared limit.
+    """
+    value = norm_version(value)
+    if not NUMERIC_VERSION_RE.fullmatch(value):
+        return None
+    return tuple(int(part) for part in value.split("."))
+
+
+def is_regression(anchored, observed):
+    """True when both are strict X.Y.Z and the observation is numerically older."""
+    anchor = numeric_version(anchored)
+    seen = numeric_version(observed)
+    return anchor is not None and seen is not None and seen < anchor
+
