pler management:"}]},{"type":"text","value":" Enables secure, policy-compliant access to private registries."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Avoid rate limiting:"}]},{"type":"text","value":" Dynamic credentials help you avoid hitting rate limits associated with static tokens."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"For more information, see "},{"type":"element","tagName":"a","properties":{"href":"/en/code-security/how-tos/secure-your-supply-chain/manage-your-dependency-security/configure-access-to-private-registries#using-oidc-for-authentication"},"children":[{"type":"text","value":"Configuring access to private registries for Dependabot"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"next-steps","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#next-steps"},"children":[{"type":"text","value":"Next steps"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"For more information about configuring OIDC, see "},{"type":"element","tagName":"a","properties":{"href":"/en/actions/how-tos/secure-your-work/security-harden-deployments"},"children":[{"type":"text","value":"Security hardening your deployments"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"For reference information about OIDC, see "},{"type":"element","tagName":"a","properties":{"href":"/en/actions/reference/security/oidc"},"children":[{"type":"text",