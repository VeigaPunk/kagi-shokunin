ype":"element","tagName":"h2","properties":{"id":"updating-your-workflows-for-oidc","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#updating-your-workflows-for-oidc"},"children":[{"type":"text","value":"Updating your workflows for OIDC"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"GitHub Actions workflows can use OIDC tokens instead of secrets to authenticate with cloud providers. Many popular cloud providers offer official login actions that simplify the process of using OIDC in your workflows. For more information about updating your workflows with specific cloud providers, see "},{"type":"element","tagName":"a","properties":{"href":"/en/actions/how-tos/secure-your-work/security-harden-deployments"},"children":[{"type":"text","value":"Security hardening your deployments"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"using-repository-custom-properties-as-oidc-claims","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#using-repository-custom-properties-as-oidc-claims"},"children":[{"type":"text","value":"Using repository custom properties as OIDC claims"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Organization and enterprise admins can include repository custom properties as claims in OIDC tokens. This enables attribute-based access control (ABAC) policies in your cloud provider, artifact registry, or secrets manager that are driven by repository metadata rather than hard-coded allow lists."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"how-custom-property-claims-work","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#how-custom-property-claims-work"},"children":[{"type":"text","value":"How custom property claims work"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"The end-to-end flow for using custom properties as OIDC claims is as follows:"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ol","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Define custom properties."}]},{"type":"text","value":" An organization or enterprise admin creates custom properties (for example, "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"business_unit"}]},{"type":"text","value":", "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"data_classification"}]},{"type":"text","value":", or "},{"type":"element","tagName":"code","properties":{},"children":[{"type":"text","value":"environment_tier"}]},{"type":"text","value":") and assigns values to repositories. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"/en/organizations/managing-organization-settings/managing-custom-properties-for-repositories-in-your-organization"},"children":[{"type":"text","value":"Managing custom properties for repositories in your organization"}]},{"type":"text","value":" and "},{"type":"element","tagName":"a","properties":{"href":"/en/actions/reference/security/oidc#including-repository-custom-properties-in-oidc-tokens"},"children":[{"type"