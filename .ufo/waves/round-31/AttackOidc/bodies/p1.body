.mint-transition-colors {
    transition-property: color, background-color, border-color, text-decoration-color, fill, stroke;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 150ms
}
.hover\:mint-bg-\[var\(--op-secure-blue-hover\)\]:hover {
    background-color: var(--op-secure-blue-hover)
}
.hover\:mint-underline:hover {
    text-decoration-line: underline
}
.dark\:mint-inline:is(.dark *) {
    display: inline
}
.dark\:mint-hidden:is(.dark *) {
    display: none
}
.dark\:mint-border-\[var\(--op-border-card-dark\)\]:is(.dark *) {
    border-color: var(--op-border-card-dark)
}
.dark\:mint-bg-\[var\(--op-surface-card-dark\)\]:is(.dark *) {
    background-color: var(--op-surface-card-dark)
}
.dark\:mint-bg-white\/5:is(.dark *) {
    background-color: rgb(255 255 255 / 0.05)
}
.dark\:mint-text-gray-300:is(.dark *) {
    --tw-text-opacity: 1;
    color: rgb(209 213 219 / var(--tw-text-opacity, 1))
}
.dark\:mint-text-gray-400:is(.dark *) {
    --tw-text-opacity: 1;
    color: rgb(156 163 175 / var(--tw-text-opacity, 1))
}
.dark\:mint-text-white:is(.dark *) {
    --tw-text-opacity: 1;
    color: rgb(255 255 255 / var(--tw-text-opacity, 1))
}</style></div></div></div></div>
