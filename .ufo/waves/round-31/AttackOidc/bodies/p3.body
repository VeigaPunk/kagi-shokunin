textLockup":{"_id":"735C27G5enIXdAlOThNgNe","type":"textLockup","entryTitle":"Credential Broker - Content Grid Section - Content Grid Item - Card 1 - Text Lockup","heading":{"_id":"bpkP2mliLqYrAwHhzOTYm","type":"redesignHeading","headingString":"ジョブを識別できるプラットフォーム","tag":"h3","size":"heading-24","weight":"Light"},"bodySize":"body-16","body":"Credential Brokerは、ポリシーに基づいてワークロードのIDを確認し、その特定のジョブに対して承認された認証情報のみを配信します。\n","isTextBalance":true}},{"_id":"6LcUm11ZESTm9XL5twVEoR","type":"contentGridItem","entryTitle":"Credential Broker - Content Grid Section - Content Grid Item - Card 2","iconImage":{"_id":"5Bv9Dvxch0q1nN0qUJWYTa","type":"image","entryTitle":"Credential Broker - Content Grid Section - Content Grid Item - Card 2 - Image","image":{"_id":"1Zg6zEIADTFJ0ySFKH3L62","type":"Asset","title":"Radar","description":"","file":{"url":"//images.ctfassets.net/2h488pz7kgfv/1Zg6zEIADTFJ0ySFKH3L62/f29e261754636ad9250503d971cdf75f/Radar.svg","details":{"size":1017,"image":{"width":48,"height":48}},"fileName":"Radar.svg","contentType":"image/svg+xml"}}},"textLockup":{"_id":"5Ew9LmkWmBUK8liv6WwUrn","type":"textLockup","entryTitle":"Credential Broker - Content Grid Section - Content Grid Item - Card 2 - Text Lockup","heading":{"_id":"5Jt5jcjoZLZ1a00G6idHpb","type":"redesignHeading","headingString":"潜在的な被害範囲を抑える","tag":"h3","size":"heading-24","weight":"Light"},"bodySize":"body-16","body":"侵害された場合でも、アクセスは1Passwordがそのジョブに許可したものに限定されます。被害範囲は限定的で、保管庫全体が侵害されることはありません。\n","isTextBalance":true}},{"_id":"1s4KOOzejL16rUc5W7vHOr","type":"contentGridItem","entryTitle":"Credential Broker - Content Grid Section - Content Grid Item - Card 3","iconImage":{"_id":"5hAwlRatpaw101Hw2dDlYK","type":"image","entryTitle":"Credential Broker - Content Grid Section - Content Grid Item - Card 3 - Image","image":{"_id":"TiikVPXKXXRc54eolO0FM","type":"Asset","title":"Clipboard","description":"","file":{"url":"//images.ctfassets.net/2h488pz7kgfv/TiikVPXKXXRc54eolO0FM/075215723a7c98f6c6b94fb0d28df968/Clipboard.svg","details":{"size":1346,"image":{"width":48,"height":48}},"fileName":"Clipboard.svg","contentType":"image/svg+xml"}}},"textLockup":{"_id":"6O7cP0QahqdGt0u6GwpYkS","type":"textLockup","entryTitle":"Credential Broker - Content Grid Section - Content Grid Item - Card 3 - Text Lockup","heading":{"_id":"1PrrHoq7xv6uvT84hSO5e4","type":"redesignHeading","headingString":"すべての配信で完全な帰属","tag":"h3","size":"heading-24","weight":"Light"},"bodySize":"body-16","body":"認証情報の配信は、アクセスがリクエストされたワークロードと、ポリシーによって認証された完全な帰属で記録されます。\n","isTextBalance":true}}]}],"removePadding":false,"removeHorizontalPadding":false},{"_id":"6XvxnCKStvliPpYX9Paixe","type":"staggeredContent","entryTitle":"Credential Broker - Staggered Content","isStaggerAnimation":false,"theme":"Transparent","eyebrow":"機能","heading":"ワークフローを接続","headingTag":"h2","headingSize":"heading-64","assetXPositionValue":0,"assetYPositionValue":0,"item":[{"_id":"6a4zVx0SdPNCcLkOr5exjh","type":"staggeredContentItem","entryTitle":"Credential Broker - Staggered Content - Item 1","image":{"_id":"7yyrmvIJqDSIcJdOXe311H","type":"Asset","title":"01 2x","description":"","file":{"url":"//images.ctfassets.net/2h488pz7kgfv/7yyrmvIJqDSIcJdOXe311H/4dc0858e7a27eb29b396f56e4f401bac/01_2x.webp","details":{"size":21002,"image":{"width":1232,"height":658}},"fileName":"01_2x.webp","contentType":"image/webp"}},"isSmallImage":false,"featureText":"GitHub Actionsを始める","featureTextSize":"heading-48","bodyCopy":"GitHub Actionsで実行されるすべてのワークフローは、そのアイデンティティを1Passwordに証明することができ、承認された適切な認証情報を受け取ります。サービスアカウントトークンは不要で、すべての配信で完全に帰属されます。","buttonLabel":"GitHub Actions を設定する","buttonLink":"https://www.1password.dev/brokered-access/github-actions"},{"_id":"3YpRANPRTODqBQJqUK0CRI","type":"staggeredContentItem","entryTitle":"Credential Broker - Staggered Content - Item 2","image":{"_id":"4WDoZcdMsRIwuzlOQVAKv7","type":"Asset","title":"02 2x","description":"","file":{"url":"//images.ctfassets.net/2h488pz7kgfv/4WDoZcdMsRIwuzlOQVAKv7/e84f2a9e6731fb43832ac656c28075a8/02_2x.webp","details":{"size":19984,"image":{"width":1232,"height":658}},"fileName":"02_2x.webp","contentType":"image/webp"}},"isSmallImage":false,"featureText":"カスタムOIDC接続でさらに掘り下げる","featureTextSize":"heading-48","bodyCopy":"OIDCトークンを発行するシステムは、1Passwordに直接認証でき、承認された認証情報をのみを取得できます。サービスアカウントトークンやシークレットが環境に保管されることはなく、すべての配信は完全に帰属しています。","buttonLabel":"カスタム OIDC ワークフローを構成する","buttonLink":"https://www.1password.dev/brokered-access/custom-workflow"}],"topSpacing":"24","bottomSpacing":"24"},{"_id":"3seSJPLdDJUTOVL9mt29as","type":"simplePromo","entryTitle":"Credential Broker - Simple Promo (UA)","colorScheme":"Bits Blue","textLockup":{"_id":"4aM8kXnQw0xpBOdRCCb8ya","type":"textLockup","entryTitle":"Credential Broker - Simple Promo - Text Lockup","eyebrowText":"発見、保護、監査","heading":{"_id":"2siZwajX2qjYE2wAw2y4mW","type":"redesignHeading","headingString":"Credential Brokerは、Unified Accessプラットフォームの一部です","tag":"h2","size":"heading-64","weight":"Light"},"bodySize":"body-20","body":"すべてのアイデンティティへのアクセスを発見、保護、監査するプラットフォームです。\n","buttons":[{"_id":"1shENvmfYKwU9WCIWMw58T","type":"btn","entryTitle":"Credential Broker - Simple Promo (UA) CTA)","label":"Unified Accessについての詳細","href":"/platform","target":"_self","variant":"secondary-refresh","primaryRefreshTheme":"White","secondaryRefreshTheme":"Secure Blue","reverseTextLinkHoverAnimation":false,"isCasino":false,"theme":"inherit","fullWidth":false}],"isTextBalance":true}},{"_id":"6KO0O6hljT1eaICAY3CJ7W","type":"faqsFeature","entryTitle":"Credential Broker - FAQs","heading":"Credential Brokerに関するよくある質問","headingTag":"h2","items":[{"_id":"2rYnEvLVVCUlhLpbultgxq","type":"faqItem","heading":"1Password Credential Brokerとは？","headingTag":"h3","body":"1Password Credential Brokerは、マシンワークロードとAIエージェントを実行時に認証し、承認された認証情報のみを提供します。ワークロードは自身の身元を証明し、ポリシーに基づいた認証情報を取得します。長期的な保管庫へのアクセスは付与されません。\n"},{"_id":"23OvkO2pSchRMI7S0PkNtu","type":"faqItem","heading":"1Password Credential Brokerがシークレットを保護する方法とは？","headingTag":"h3","body":"Credential Brokerは、統合キーと、1Passwordのコンフィデンシャルコンピューティングエンクレーブ（隔離された、ハードウェアで保護された実行環境）内にロックされたキーの2つのキーですべてのシークレットを暗号化します。認証情報の復号化には両方のキーが必要です。どちらも単独でシークレットにアクセスすることはできません。\n"},{"_id":"1EFoWZhp2FE99ELeNjj6AV","type":"faqItem","heading":"1Password Credential Brokerが認証情報を配信する際に記録される内容とは？","headingTag":"h3","body":"すべての認証情報の配信は、アクセスがリクエストされたワークロードと、ポリシーによって認証された完全な帰属で記録されます。セキュリティチームは、すべての発行イベントに対して完全な監査証跡を取得できます。\n"},{"_id":"6RvEFHgu9mAF6eoxIJUFsW","type":"faqItem","heading":"1Password Credential Brokerがワークロードのアイデンティティを検証する方法とは？","headingTag":"h3","body":"Credential Brokerは、認証情報を配信する前に、Workload Identity Federationを使用してワークロードのIDを検証します。Workload Identity Federationは、手動管理型のサービスアカウントトークンに依存することなく、プラットフォームが実行されている特定のジョブを証明するのを可能にする標準規格です。検証が完了すると、ワークロードは承認されたジョブの認証情報のみを受け取り、それ以外のものは何も受け取りません。\n"},{"_id":"37Ny34OlFm9sODMplPDNvG","type":"faqItem","heading":"1Password Credential BrokerはGitHub Actionsで動作しますか？","headingTag":"h3","body":"はい。GitHub Actionsのワークフローは、Workload Identity Federationを使用して1PasswordにIDを証明し、承認された適切な認証情報を受け取ることができます。サービスアカウントトークンは不要であり、すべての配信は完全な帰属とともに記録されます。\n"},{"_id":"1VKRAw6PfftNnQKi5yJKk8","type":"faqItem","heading":"1Password Credential Brokerは一般提供されていますか？","headingTag":"h3","body":"まだ一般提供されていません。Credential Brokerは現在、すべてのEnterprise Password Managerのお客様向けにプレビュー版が公開されています。これにはGitHub ActionとカスタムOIDC構成が含まれています。開始するには、こちらのドキュメントページをご覧ください：[1password.dev/environments/credential-broker](https://1password.dev/environments/credential-broker)。\n"}],"theme":"Iron Ore 50"},{"_id":"7aAkFy7dONvzmN0V3citON","type":"simplePromo","entryTitle":"Credential Broker - Simple Promo (Runtime access)","colorScheme":"Secure Blue","textLockup":{"_id":"1VzVeZqGfaXl17kDfKzyuM","type":"textLockup","entryTitle":"Credential Broker - Simple Promo (Runtime access)","heading":{"_id":"3GNataLfpnRApriBdO06Z0","type":"redesignHeading","headingString":"Runtime access for every machine and AI agent starts with 1Password","tag":"h2","size":"heading-64","weight":"Light"},"bodySize":"body-20","body":"Meet with a member of our team to discuss how 1Password Credential Broker can extend your existing 1Password foundation to every workload and AI agent.","buttons":[{"_id":"3LEtVCHwfxqzuf0OS4fEZK","type":"btn","entryTitle":"Credential Broker - Simple Promo (Runtime access) - CTA","label":"Request a demo","href":"/contact-sales","target":"_self","variant":"primary-refresh","primaryRefreshTheme":"White","reverseTextLinkHoverAnimation":false,"isCasino":false,"theme":"inherit","fullWidth":false}],"isTextBalance":true}}],"footer":{"_id":"2L3ivuQo1leO4hKcJAHW57","type":"redesignFullFooter","entryTitle":"Full Footer","navigationItems":[{"_id":"1EEvOajNMvRQ7dpCdDed4L","type":"navigationItemGroup","title":"Unified Access Platform","tag":"h6","navigationItems":[{"_id":"f3wLxY3nmlu3d5JbfJM0z","type":"navigationItem","entryTitle":"Footer - Unified Access","item":"Unified Access","href":"/jp/product/unified-access","hasBadge":false,"isBadge":false,"isTargetBlank":false,"isPrivacyOption":false,"ccpaIconAltText":"California Consumer Privacy Act (CCPA) Opt-Out Icon","validation":"true"},{"_id":"1gB5yCnfdUThuDja4cLzKT","type":"navigationItem","entryTitle":"Footer - EPM","item":"エンタープライズパスワードマネージャー","href":"/jp/product/enterprise-password-manager","hasBadge":false,"isBadge":false,"isTargetBlank":false,"validation":"true"},{"_id":"4geTsyWB0TsdpZl21xjD4u","type":"navigationItem","entryTitle":"Footer - Credential Broker","item":"Credential Broker","href":"/jp/product/credential-broker","hasBadge":false,"isBadge":false,"isTargetBlank":false,"isPrivacyOption":false,"ccpaIconAltText":"California Consumer Privacy Act (CCPA) Opt-Out Icon","validation":"true"},{"_id":"53NjqZfJRQAtocDqEktO2B","type":"navigationItem","entryTitle":"Footer - Privileged Access","item":"Privileged Access","href":"/jp/product/privileged-access","hasBadge":false,"isBadge":false,"isTargetBlank":false,"isPrivacyOption":false,"ccpaIconAltText":"California Consumer Privacy Act (CCPA) Opt-Out Icon","validation":"true"},{"_id":"1pm4m0BbofnCfXOdvcoYXE","type