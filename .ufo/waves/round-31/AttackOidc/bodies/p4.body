atest/UserGuide/id_roles_providers_create_oidc.html" /><meta name="keywords" content="IAM,AWS Identity and Access Management,IAM user,user,IAM group,group,IAM role,role,permission policy,trust policy,policy,access key,password,AWS IAM federation,identity federation,IAM SAML,IAM OIDC,OpenID Connect,OIDC" /><script type="application/ld+json">
