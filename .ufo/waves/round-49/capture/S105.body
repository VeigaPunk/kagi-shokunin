<h4 class="anchor anchorTargetStickyNavbar_Q9z1" id=sample-request-34>Sample request<a href=#sample-request-34 class=hash-link aria-label="Direct link to Sample request" title="Direct link to Sample request" translate=no>​</a></h4>
<div class="language-shell-session codeBlockContainer_e91z theme-code-block" style=--prism-color:#393A34;--prism-background-color:#f6f8fa><div class=codeBlockContent_G3Pk><pre tabindex=0 class="prism-code language-shell-session codeBlock_H5oe thin-scrollbar" style=color:#393A34;background-color:#f6f8fa><code class=codeBlockLines_OQl4><div class=token-line style=color:#393A34><span class="token plain">$ curl \</span><br/></div><div class=token-line style=color:#393A34><span class="token plain">    --header "X-Vault-Token: ..." \</span><br/></div><div class=token-line style=color:#393A34><span class="token plain">    --request POST \</span><br/></div><div class=token-line style=color:#393A34><span class="token plain">    --data @payload.json \</span><br/></div><div class=token-line style=color:#393A34><span class="token plain">    http://127.0.0.1:8200/v1/pki/keys/import</span><br/></div></code></pre></div></div>
<h4 class="anchor anchorTargetStickyNavbar_Q9z1" id=sample-response-32>Sample response<a href=#sample-response-32 class=hash-link aria-label="Direct link to Sample response" title="Direct link to Sample response" translate=no>​</a></h4>
