<div class="language-shell-session codeBlockContainer_e91z theme-code-block" style=--prism-color:#393A34;--prism-background-color:#f6f8fa><div class=codeBlockContent_G3Pk><pre tabindex=0 class="prism-code language-shell-session codeBlock_H5oe thin-scrollbar" style=color:#393A34;background-color:#f6f8fa><code class=codeBlockLines_OQl4><div class=token-line style=color:#393A34><span class="token plain">$ curl \</span><br/></div><div class=token-line style=color:#393A34><span class="token plain">    --header "X-Vault-Token: ..." \</span><br/></div><div class=token-line style=color:#393A34><span class="token plain">    --header "Content-Type: application/merge-patch+json"</span><br/></div><div class=token-line style=color:#393A34><span class="token plain">    --request PATCH \</span><br/></div><div class=token-line style=color:#393A34><span class="token plain">    --data @payload.json \</span><br/></div><div class=token-line style=color:#393A34><span class="token plain">    https://127.0.0.1:8200/v1/secret/data/my-secret</span><br/></div></code></pre></div></div>
