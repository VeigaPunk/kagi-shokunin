gray-700 dark:text-gray-300 font-normal" tabindex="-1"><div class="flex gap-1 items-center max-w-[calc(100%_-_18px)]" title="Block secrets from leaking"><span data-cy="public-left-nav-document-icon-container" class="box-border w-6 h-6 p-[2.5px] mr-0"><span class="ab-font-emoji flex items-center justify-center size-[16px] text-[16px] leading-[16px] box-border text-gray-400 dark:text-gray-500">✋</span></span><span data-cy="public-left-nav-document-name" class="px-1 truncate">Block secrets from leaking</span></div><div data-cy="public-left-nav-item-expand-button" class="ab-tab-focus flex items-center justify-center self-start w-6 h-6 shrink-0" role="button" aria-label="expandable" tabindex="0"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right ab-left-nav-chevron transform w-4 h-4 transition-transform text-gray-400 dark:text-gray-500" aria-hidden="true" data-cy="public-left-nav-item-expand-icon"><path d="m9 18 6-6-6-6"></path></svg></div></div></a></div></div><div data-cy="public-left-nav-document" title="Shared secrets" class="ab-windy-link-group-wrap"><div class="ab-windy-nav-link-wrap mb-0.5 rounded-lg text-gray-700 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-300 hover:bg-gray-50 hover:dark:bg-gray-800 pl-(--ab-windy-nav-indent)" style="--ab-windy-nav-indent:0.2rem"><a class="ab-tab-focus block" href="/docs/shared-secrets"><div data-cy="public-left-nav-document-button" class="ab-windy-nav-link ab-tab-focus cursor-pointer p-2 select-none flex items-center justify-between ab-windy-nav-link-inactive text-gray-700 dark:text-gray-300 font-normal" tabindex="-1"><div class="flex gap-1 items-center max-w-full" title="Shared secrets"><span data-cy="public-left-nav-document-icon-container" class="box-border w-6 h-6 p-[2.5px] mr-0"><span class="ab-font-emoji flex items-center justify-center size-[16