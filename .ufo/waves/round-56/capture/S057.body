ionalRuleId":"","docTags":[]},{"id":"PUBLISHED-tX3MsY5lSQT3Bn_THY5ZM","children":[],"expanded":false,"name":"2025 June","urlKey":"docs/2025-june","icon":"🐷","parentDocId":"PUBLISHED-WdUZZZFEqbzRHXJyNn2kc","conditionalRuleId":"","docTags":[]},{"id":"PUBLISHED-7LYp9IJnfnD59m2Uk2_9i","children":[],"expanded":false,"name":"2025 May","urlKey":"docs/2025-may","icon":"🐷","parentDocId":"PUBLISHED-WdUZZZFEqbzRHXJyNn2kc","conditionalRuleId":"","docTags":[]}],"name":"TruffleHog Release Notes","isFoldedByDefault":true,"changedInBranch":{"isFolded":true},"expanded":false,"urlKey":"docs/trufflehog-release-notes","icon":"🐷","parentDocId":"","conditionalRuleId":"","docTags":[]}],"hostingTitle":"","hostingDescription":"","thumbnailURL":"","logoRedirectURL":"","hasPrimaryColorLinks":true,"hostingColor":"#38645a","darkHostingColor":"#AE8C57","secondaryColor":"#F4EFE9","darkSecondaryColor":"#252525","isIndexable":true,"template":"windy","contentLayout":"one-column","contentWidth":null,"docTreeIndent":null,"hostname":"docs-archbee.trufflesecurity.com","hostnamePath":"docs","proxyDomain":"trufflesecurity.com","publicLogoURL":"","darkPublicLogoURL":"","publicTheme":"auto","faviconURL":"https://cdn.images.archbee.com/S23bFlGfp3a-8_a9YY_cE/hIltNLZ3j929122wWthvL_trufflepig.png","spaceLinks":[],"versionLinks":[],"externalLinks":[],"landingPageType":"first-doc","landingTemplate":"","landingPageHeaderText":"","landingPageSubheaderText":"","landingHeroBgLightURL":"","landingHeroBgDarkURL":"","footerTemplate":"","headerIncludes":"","jwtRedirectURL":"","googleAnalyticsId":"","intercomId":"","isArchbeeBrandVisible":false,"archbeeBrandPosition":"doc-tree","i18nLanguage":"en","showReadTime":true,"showLastUpdate":true,"showThemeSwitcher":true,"showContributors":true,"showDocFeedback":true,"showEditInGitApp":true,"showDocNavigationButtons":true,"revisions":[],"customJS":"\u003cscript\u003e\n  (function() {\n    if (typeof window === 'undefined') return;\n    if (typeof window.signals !== 'undefined') return;\n    var script = document.createElement('script');\n    script.src = 'https://cdn.cr-proxy.com/v1/site/1b71ac21-9c78-4dd4-a526-9fd60bb3b468/signals.js';\n    script.async = true;\n    window.signals = Object.assign(\n      [],\n      { _opts: { apiHost: 'https://api.cr-proxy.com' } },\n      ['page', 'identify', 'form'].reduce(function (acc, method){\n        acc[method] = function () {\n          signals.push([method, arguments]);\n          return signals;\n        };\n       return acc;\n      }, {})\n    );\n    document.head.appendChild(script);\n  })();\n\u003c/script\u003e","customCSS":"\u003cstyle\u003e\n#ab-left-nav-public-wrap {\nmargin-bottom: 2em;\n}\n\u003c/style\u003e","customFont":{"headerLink":"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900\u0026display=swap","isEnabled":true,"family":"Inter","id":"Inter","category":"sans-serif"},"custom404":"","createdAt":"2024-01-24T16:31:45.187Z","showPdfBookLink":false,"pdfExportConfig":{"coverShowGeneratedDate":false,"coverShowExternalLinks":false,"coverTitle":"","coverSubtitle":"","headerShow":true,"headerShowLogo":true,"headerRightContent":"currentCategory","footerShow":true,"footerShowPageNumber":true,"footerNote":"buildDate","footerCustomNote":"","contentNumberSections":true,"contentNumberHeadings":false,"contentShowWatermark":false,"contentWatermarkText":"","securityPasswordProtect":false,"securityPassword":""},"pdfBookLink":"https://archbee-doc-uploads.s3.amazonaws.com/export/pdf-space/HhmeFXvPfYzxTfWopTB_0-20260819-0734.pdf","llmsTxtLink":"https://archbee-doc-uploads.s3.amazonaws.com/export/llms-txt/PUBLISHED-HhmeFXvPfYzxTfWopTB_0-llms.txt","llmsFullTxtLink":"https://archbee-doc-uploads.s3.amazonaws.com/export/llms-txt/PUBLISHED-HhmeFXvPfYzxTfWopTB_0-llms-full.txt","sitemapXmlLink":"https://archbee-doc-uploads.s3.amazonaws.com/export/sitemap-xml/PUBLISHED-HhmeFXvPfYzxTfWopTB_0-sitemap.xml","protectionTypes":["None"],"portalAccess":"public","isAuthenticated":true,"isSilentLoginEnabled":false,"tagsCache":[],"isQAndAEnabled":false,"isQAndAPublicEnabled":false,"isQAndAPublicByDefault":false,"isQAndAAIEnabled":false,"isQAndAApprovalEnabled":false,"isLlmEnabled":false,"isLlmInternal":true,"isLlmExternal":true,"externalAiPrompts":[],"authPageLayout":"one-column","authPagePosition":"left","authBgImageURL":"","authDarkBgImageURL":"","gitAppRepoId":"","gitAppRepo":null,"isGithubEnabled":false,"isBitbucketEnabled":false,"isGitlabEnabled":false,"isAzureDevOpsEnabled":false,"doc":{"id":"PUBLISHED-WAGmyVsXJa55dE10SNae_","name":"Verification caching","icon":"{\"faIcon\":\"fa-solid fa-arrow-rotate-right\"}","title":"Verification caching","previewImageURL":"","summary":null,"urlKey":"docs/verification-caching","description":"","urlAlias":"","data":{"nodes":[{"id":"K-ag4JrwM9f0FROW7UjF-","type":"paragraph","children":[{"text":"After a TruffleHog scanner attempts to verify a secret it finds, it will cache the result of the verification attempt. Subsequent attempts to verify that same secret will use the cached result instead of making another remote request. This prevents TruffleHog from overwhelming verification endpoints, which can cause account lockouts and other problems."}]},{"id":"CnpV7_WSuY_R-H2mnROX4","type":"paragraph","children":[{"text":"The cache does not store raw secrets in memory; it stores secret hashes instead. Secrets are not persisted in memory longer than is necessary to verify them."}]},{"id":"JQ5hLTpZqwSREHg4q-_wj","type":"paragraph","children":[{"text":"Each scanner process has its own cache, which means that if you are running multiple scanners as part of TruffleHog Enterprise, they will not share a cache. Caches are not persisted when scanner processes terminate. If you are using TruffleHog Enterprise to scan multiple sources using the same scanner process, they will all share a single cache."}]},{"id":"LTg0fZ3Xqcm-2HQXwWAG8","type":"paragraph","children":[{"text":"Each cache entry expires after three hours. Cache items will also expire on a least-recently-used basis if the cache begins to grow too large."}]},{"id":"58WKUdjgUK-7ONQpiA4wo","type":"paragraph","children":[{"text":"The "},{"id":"kgbm8hJV9OR8iwUw2ai9S","type":"mention-doc","data":{"label":"Reverify secrets","spaceId":"HhmeFXvPfYzxTfWopTB_0","docId":"FgxqP1tpF824GTh_vbOhQ","version":"v2","docAnchorId":"","loadingMethod":"static","overridedLabel":"","href":"/docs/reverify-secrets"},"children":[{"text":""}]},{"text":" feature of TruffleHog Enterprise will not use the cache. Reverification scans initiated by this feature will always make remote verification requests. However, the results of these requests will be loaded back into the cache so they can be used by future scans."}]},{"id":"zZ5Tfib0yzBpqJD3nCtvV","type":"paragraph","children":[{"text":"If you are using TruffleHog OSS, your scan output will include "},{"text":"(Verification info cached)","highlight":true},{"text":" for each secret that had its verification status loaded from the cache rather than retrieved from a verification endpoint."}]},{"id":"j2PZmrm1Yo-QQzwrCI5Ne","type":"paragraph","children":[{"text":"The internal architecture of TruffleHog is such that the cache does not "},{"text":"guarantee","italic":true},{"text":" that duplicate verification requests are never made. It does, however, greatly reduce their incidence."}]}],"metadata":{"type":"doc","version":"v2","convertedDate":"2025-05-01T17:50:55.601Z"}},"version":3,"privacy":"shared with team","shareableToken":"","tags":[],"docTags":[],"children":[],"hasDraft":false,"createdByUserId":"","createdBy":{"id":"","fullName":"","firstName":"","lastName":"","email":"","profilePhotoURL":""},"lastModifiedBy":{"id":"","fullName":"","firstName":"","lastName":"","email":"","profilePhotoURL":""},"contributorsDetails":[{"id":"C0attpa0wYIIY7GgY5mUx","fullName":"Ian Sharpe","email":"","firstName":"Ian","lastName":"Sharpe","profilePhotoURL":"https://lh3.googleusercontent.com/a/ACg8ocLZfn4E9saPWJxPuYY8qLqZao33vCDfDyoY1eDXZtv-1UKU-w=s96-c"},{"id":"Zqh1qcyDHLiO8ye0iF5zp","fullName":"Cody Rose","email":"","firstName":"Cody","lastName":"Rose","profilePhotoURL":"https://archbee-profile-photos.s3.amazonaws.com/S23bFlGfp3a-8_a9YY_cE/kAUR8JTYyJJdIOScaIbq9_.blob"}],"watchers":[],"isArchbeeBrandVisible":false,"customCSS":"\u003cstyle\u003e\n#ab-left-nav-public-wrap {\nmargin-bottom: 2em;\n}\n\u003c/style\u003e","customJS":"\u003cscript\u003e\n  (function() {\n    if (typeof window === 'undefined') return;\n    if (typeof window.signals !== 'undefined') return;\n    var script = document.createElement('script');\n    script.src = 'https://cdn.cr-proxy.com/v1/site/1b71ac21-9c78-4dd4-a526-9fd60bb3b468/signals.js';\n    script.async = true;\n    window.signals = Object.assign(\n      [],\n      { _opts: { apiHost: 'https://api.cr-proxy.com' } },\n      ['page', 'identify', 'form'].reduce(function (acc, method){\n        acc[method] = function () {\n          signals.push([method, arguments]);\n          return signals;\n        };\n       return acc;\n      }, {})\n    );\n    document.head.appendChild(script);\n  })();\n\u003c/script\u003e","parentDocId":"PUBLISHED-FgxqP1tpF824GTh_vbOhQ","docSpaceId":"PUBLISHED-HhmeFXvPfYzxTfWopTB_0","updatedAt":"2026-07-06T14:59:18.138Z","createdAt":"2025-05-01T17:50:55.601Z","deletedAt":null,"editable":false,"expanded":true,"reusableContentVariables":[{"contentVariableId":"lhdPPJGAVaDFwCaqJGkkS","name":"source","content":"Source integration","scope":"global","spaceTargetMap":{}}],"reusableContentDocRefs":{},"externalSync":"","contentFromExternalLink":"","leftDoc":{"id":"PUBLISHED-FgxqP1tpF824GTh_vbOhQ","children":[{"id":"PUBLISHED-WAGmyVsXJa55dE10SNae_","children":[],"expanded":false,"name":"Verification caching","urlKey":"docs/verification-caching","icon":"{\"faIcon\":\"fa-solid fa-arrow-rotate-right\"}","parentDocId":"PUBLISHED-FgxqP1tpF824GTh_vbOhQ","conditionalRuleId":"","docTags":[]}],"name":"Reverify secrets","isFoldedByDefault":true,"changedInBranch