  } catch (e) {}
})();</script></div></div></div></div></div></nav><main id="content-container" class="lg:flex-1 lg:min-w-0"><script>document.documentElement.setAttribute('data-page-mode', "none");</script><style>html{background:rgb(var(--background-light))!important}html.dark{background:rgb(var(--background-dark))!important}html body{background:transparent!important}</style><span class="fixed inset-0 -z-10 pointer-events-none" id="background-color"></span><span class="block absolute dark:hidden inset-0 overflow-hidden pointer-events-none"></span><span class="hidden absolute dark:block inset-0 overflow-hidden pointer-events-none"></span><!--$--><!--/$--><div class="flex flex-row-reverse gap-12 box-border w-full pt-[calc(10rem+var(--banner-height,2.5rem))] lg:pt-10"><div class="hidden xl:flex self-start sticky xl:flex-col max-w-[28rem] z-21 h-[calc(100vh-9.5rem)] top-[9.5rem] [[data-banner-state=visible]_&amp;]:h-[calc(100vh-12rem)] [[data-banner-state=visible]_&amp;]:top-[12rem]" id="content-side-layout" data-layout-item="side-panel"><div class="z-10 hidden xl:flex box-border max-h-full pl-10 w-[19rem]" id="table-of-contents-layout" data-layout-item="toc"><div role="presentation" style="position:relative;--scroll-area-corner-height:0px;--scroll-area-corner-width:0px" data-component-part="scroll-area" id="table-of-contents" data-layout-item="toc-content" data-shell="panel" data-marker="none" data-look="default" class="min-w-0 text-gray-600 text-sm leading-6 w-[16.5rem] -mt-10 group/toc"><div data-id="base-ui-_R_beehkd74t9_-viewport" tabindex="-1" class="size-full rounded-[inherit] [--scroll-area-fade-size:32px] pt-10 pb-4 base-ui-disable-scrollbar" style="overflow:scroll" data-component-part="scroll-area-viewport"><div role="presentation" style="min-width:fit-content" data-component-part="scroll-area-content" class="min-w-0! w-full space-y-2"><nav aria-labelledby="_R_3eehkd74t9_"><h2 id="_R_3eehkd74t9_" data-layout-item="toc-title"><button type="button" aria-describedby="_R_3eehkd74t9H1_"><svg aria-hidden="true" width="18" height="18" stroke-width="2" class="size-3 shrink-0"><use href="#mi-mint-1-TableOfContents"></use></svg><span>On this page</span></button></h2><span id="_R_3eehkd74t9H1_" hidden="">Back to top</span><ul id="table-of-contents-content" class="toc" data-layout-item="toc-list"><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#step-1-set-up-an-environment">Step 1: Set up an Environment</a></li><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#step-2-connect-your-environment-to-your-workflow">Step 2. Connect your Environment to your workflow</a></li><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#step-3-use-your-environment-in-your-workflow">Step 3: Use your Environment in your workflow</a></li><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#usage-example">Usage example</a></li><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#get-help">Get help</a></li><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#learn-more">Learn more</a></li></ul></nav></div></div></div></div></div><div class="relative grow box-border flex-col w-full mx-auto px-1 lg:pl-[5.7rem] lg:-ml-12 xl:w-[calc(100%-28rem)] lg:max-w-[calc(var(--content-width,100vw)+5.95rem)]" data-empty-page-layout="" id="content-area" data-layout-item="content"><header id="header" data-layout-item="page-header" class="relative leading-none @container/page-header"><div class="mt-0.5 space-y-2.5"><div class="eyebrow h-5 text-primary dark:text-primary-light text-sm font-semibold">Credential Broker (public preview)</div><div class="flex flex-col sm:flex-row items-start sm:items-center relative gap-2 min-w-0"><h1 id="page-title" class="text-3xl sm:text-4xl text-gray-900 tracking-tight dark:text-gray-200 [overflow-wrap:anywhere] font-semibold">Use 1Password Credential Broker to access secrets in custom workflows at runtime (public beta)</h1><div id="page-context-menu" class="items-center shrink-0 min-w-[156px] justify-end ml-auto hidden @[520px]/page-header:flex"><button id="page-context-menu-button" class="rounded-l-xl px-3 text-gray-700 dark:text-gray-300 py-1.5 border border-gray-200 dark:border-white/[0.07] bg-background-light dark:bg-background-dark hover:bg-gray-600/5 dark:hover:bg-gray-200/5 border-r-0" aria-label="Copy page"><div class="flex items-center gap-2 text-sm text-center font-medium"><svg aria-hidden="true" width="18" height="18" stroke-width="1.5" class="size-4 shrink-0"><use href="#mi-mint-1-Copy"></use></svg><span class="grid"><span aria-hidden="true" class="invisible col-start-1 row-start-1">Copy page</span><span class="col-start-1 row-start-1">Copy page</span></span></div></button><button type="button" tabindex="0" aria-haspopup="menu" aria-expanded="false" id="base-ui-_R_re4deehkd74t9_" aria-label="More actions" class="group disabled:pointer-events-none [&amp;&gt;span]:line-clamp-1 overflow-hidden group focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary dark:focus-visible:outline-primary-light py-0.5 gap-1 text-sm text-gray-950/50 dark:text-white/50 group-hover:text-gray-950/70 dark:group-hover:text-white/70 rounded-none rounded-r-xl border flex items-center justify-center h-[34px] border-gray-200 aspect-square dark:border-white/[0.07] bg-background-light dark:bg-background-dark hover:bg-gray-600/5 dark:hover:bg-gray-200/5"><svg aria-hidden="true" width="18" height="18" stroke-width="2" focusable="false" class="size-3 transition-transform text-gray-400 group-hover:text-gray-600 dark:text-gray-600 dark:group-hover:text-gray-400 shrink-0 rotate-90"><use href="#mi-mint-1-ChevronRight"></use></svg></button></div></div></div><div class="mt-2 text-lg prose prose-gray dark:prose-invert [&amp;&gt;*]:[overflow-wrap:anywhere]"><p>Learn how to configure custom workflows to retrieve secrets from 1Password Environments at runtime.</p></div><div id="page-context-menu" class="flex items-center shrink-0 min-w-[156px] mt-3 @[520px]/page-header:hidden"><button id="page-context-menu-button" class="rounded-l-xl px-3 text-gray-700 dark:text-gray-300 py-1.5 border border-gray-200 dark:border-white/[0.07] bg-background-light dark:bg-background-dark hover:bg-gray-600/5 dark:hover:bg-gray-200/5 border-r-0" aria-label="Copy page"><div class="flex items-center gap-2 text-sm text-center font-medium"><svg aria-hidden="true" width="18" height="18" stroke-width="1.5" class="size-4 shrink-0"><use href="#mi-mint-1-Copy"></use></svg><span class="grid"><span aria-hidden="true" class="invisible col-start-1 row-start-1">Copy page</span><span class="col-start-1 row-start-1">Copy page</span></span></div></button><button type="button" tabindex="0" aria-haspopup="menu" aria-expanded="false" id="base-ui-_R_1mcdeehkd74t9_" aria-label="More actions" class="group disabled:pointer-events-none [&amp;&gt;span]:line-clamp-1 overflow-hidden group focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary dark:focus-visible:outline-primary-light py-0.5 gap-1 text-sm text-gray-950/50 dark:text-white/50 group-hover:text-gray-950/70 dark:group-hover:text-white/70 rounded-none rounded-r-xl border flex items-center justify-center h-[34px] border-gray-200 aspect-square dark:border-white/[0.07] bg-background-light dark:bg-background-dark hover:bg-gray-600/5 dark:hover:bg-gray-200/5"><svg aria-hidden="true" width="18" height="18" stroke-width="2" focusable="false" class="size-3 transition-transform text-gray-400 group-hover:text-gray-600 dark:text-gray-600 dark:group-hover:text-gray-400 shrink-0 rotate-90"><use href="#mi-mint-1-ChevronRight"></use></svg></button></div></header><div class="mdx-content @container/columns-container relative mt-8 prose prose-gray dark:prose-invert [contain:inline-size] isolate empty:hidden mb-14" data-page-title="Use 1Password Credential Broker to access secrets in custom workflows at runtime (public beta)" data-page-href="/brokered-access/custom-workflow" id="content">
<span data-as="p">If an administrator has <a href="/brokered-access" class="link">connected an OIDC provider to your 1Password Business account</a>, you can use 1Password to access secrets from your 1Password Environments in your custom workflows at runtime.</span>
<h2 class="flex whitespace-pre-wrap group font-semibold" id="step-1-set-up-an-environment" aria-labelledby="_R_55deehkd74t9_"><div class="absolute" tabindex="-1"><a href="#step-1-set-up-an-environment" class="-ml-10 flex items-center opacity-0 border-0 group-hover:opacity-100 focus:opacity-100 focus:outline-0 group/link" aria-label="Navigate to header: Step 1: Set up an Environment">​<div class="size-6 rounded-md flex items-center justify-center shadow-xs text-gray-400 dark:text-white/50 dark:bg-background-dark dark:brightness-[1.35] dark:ring-1 dark:hover:brightness-150 bg-white ring-1 ring-gray-400/30 dark:ring-gray-700/25 hover:ring-gray-400/60 dark:hover:ring-white/20 group-focus/link:border-2 group-focus/link:border-primary dark:group-focus/link:border-primary-light"><svg aria-hidden="true" width="18" height="18" stroke-width="2" class="size-3 shrink-0"><use href="#mi-mint-1-Link"></use></svg></div></a></div><span id="_R_55deehkd74t9_" class="cursor-pointer">Step 1: Set up an Environment</span></h2>
<span data-as="p">To configure the secrets you need to use in a custom workflow, make sure you have the <a href="https://support.1password.com/betas/#install-a-prerelease-version-of-the-1password-app" target="_blank" rel="noreferrer" class="link">latest beta release of the 1Password desktop app</a>, then create a new <a href="/environments#create-an-environment" class="link">1Password Environment</a> with your secrets or <a href="/environments#add-secrets-to-an-environment" class="link">add your secrets</a> to an existing Environment.</span>
<h2 class="flex whitespace-pre-wrap group font-semibold" id="step-2-connect-your-environment-to-your-workflow" aria-labelledby="_R_95deehkd74t9_"><div class="absolute" tabindex="-1"><a href="#step-2-connect-your-environment-to-your-workflow" class="-ml-10 flex items-center opacity-0 border-0 group-hover:opacity-100 focus:opacity-100 focus:outline-0 group/link" aria-label="Navigate to header: Step 2. Connect your Environment to your workflow">​<div class="size-6 rounded-md flex items-center justify-center shadow-xs text-gray-400 dark:text-white/50 dark:bg-background-dark dark:brightness-[1.35] dark:ring-1 dark:hover:brightness-150 bg-white ring-1 ring-gray-400/30 dark:ring-gray-700/25 hover:ring-gray-400/60 dark:hover:ring-white/20 group-focus/link:border-2 group-focus/link:border-primary dark:group-focus/link:border-primary-light"><svg aria-hidden="true" width="18" height="18" stroke-width="2" class="size-3 shrink-0"><use href="#mi-mint-1-Link"></use></svg></div></a></div><span id="_R_95deehkd74t9_" class="cursor-pointer">Step 2. Connect your Environment to your workflow</span></h2>
<span data-as="p">After you’ve set up an Environment and added your secrets, you can connect the Environment to your workflow:</span>
<ol>
<li>Open your Environment, then select <strong>Connect</strong> in the “Custom workflow (OIDC)” section.<!-- -->
<div role="note" aria-label="Tip" class="callout my-4 px-5 py-4 overflow-hidden rounded-2xl flex gap-3 border border-green-200 bg-green-50 dark:border-green-900 dark:bg-green-600/20 [&amp;_[data-component-part=&#x27;callout-icon&#x27;]]:mt-px" data-callout-type="tip"><div class="mt-0.5 w-4" data-component-part="callout-icon"><svg aria-hidden="true" width="18" height="18" stroke-width="1.5" class="size-4.5 text-green-800 dark:text-green-300"><use href="#mi-mint-1-CalloutTip"></use></svg></div><div class="text-sm prose dark:prose-invert min-w-0 w-full [&amp;_kbd]:bg-background-light dark:[&amp;_kbd]:bg-background-dark [&amp;_code]:text-current! [&amp;_kbd]:text-current! [&amp;_a]:text-current! [&amp;_a]:border-current [&amp;_strong]:text-current! text-green-800 dark:text-green-300" data-component-part="callout-content"><span data-as="p">If you’ve already connected your Environment to a workflow, select
<strong>Connect</strong> instead, then select <strong>Connect</strong> in the “Custom workflow (OIDC)” section.</span></div></div>
</li>
<li>Enter a name for your workflow, then choose the integration for the OIDC provider you need to use.</li>
<li>(Optional) Define any additional access conditions you want to enforce. You’ll also see any inherited conditions your administrator configured for the integration.</li>
<li>Select <strong>Connect</strong>.</li>
</ol>
<h2 class="flex whitespace-pre-wrap group font-semibold" id="step-3-use-your-environment-in-your-workflow" aria-labelledby="_R_f5deehkd74t9_"><div class="absolute" tabindex="-1"><a href="#step-3-use-your-environment-in-your-workflow" class="-ml-10 flex items-center opacity-0 border-0 group-hover:opacity-100 focus:opacity-100 focus:outline-0 group/link" aria-label="Navigate to header: Step 3: Use your Environment in your workflow">​<div class="size-6 rounded-md flex items-center justify-center shadow-xs text-gray-400 dark:text-white/50 dark:bg-background-dark dark:brightness-[1.35] dark:ring-1 dark:hover:brightness-150 bg-white ring-1 ring-gray-400/30 dark:ring-gray-700/25 hover:ring-gray-400/60 dark:hover:ring-white/20 group-focus/link:border-2 group-focus/link:border-primary dark:group-focus/link:border-primary-light"><svg aria-hidden="true" width="18" height="18" stroke-width="2" class="size-3 shrink-0"><use href="#mi-mint-1-Link"></use></svg></div></a></div><span id="_R_f5deehkd74t9_" class="cursor-pointer">Step 3: Use your Environment in your workflow</span></h2>
<span data-as="p">After you’ve connected your Environment to a custom workflow, you’ll need to create a <a href="/sdks" class="link">1Password SDK</a> client configured with a custom function to fetch your OIDC token. The client authenticates using your OIDC token, workload ID, and the <a href="/brokered-access#custom-workflow-oidc" class="link">integration key configured by your administrator</a>, then uses a function to retrieve secrets from your Environment using the Environment ID.</span>
<div role="note" aria-label="Note" class="callout my-4 px-5 py-4 overflow-hidden rounded-2xl flex gap-3 border border-blue-200 bg-blue-50 dark:border-blue-900 dark:bg-blue-600/20" data-callout-type="note"><div class="mt-0.5 w-4" data-component-part="callout-icon"><svg aria-hidden="true" width="18" height="18" stroke-width="1.5" class="size-4 text-blue-800 dark:text-blue-300"><use href="#mi-mint-1-CalloutNote"></use></svg></div><div class="text-sm prose dark:prose-invert min-w-0 w-full [&amp;_kbd]:bg-background-light dark:[&amp;_kbd]:bg-background-dark [&amp;_code]:text-current! [&amp;_kbd]:text-current! [&amp;_a]:text-current! [&amp;_a]:border-current [&amp;_strong]:text-current! text-blue-800 dark:text-blue-300" data-component-part="callout-content"><span data-as="p">1Password Credential Broker is only supported in the <a href="https://github.com/1Password/onepassword-sdk-js" target="_blank" rel="noreferrer" class="link">1Password JavaScript SDK</a> at this time.</span></div></div>
<h2 class="flex whitespace-pre-wrap group font-semibold" id="usage-example" aria-labelledby="_R_l5deehkd74t9_"><div class="absolute" tabindex="-1"><a href="#usage-example" class="-ml-10 flex items-center opacity-0 border-0 group-hover:opacity-100 focus:opacity-100 focus:outline-0 group/link" aria-label="Navigate to header: Usage example">​<div class="size-6 rounded-md flex items-center justify-center shadow-xs text-gray-400 dark:text-white/50 dark:bg-background-dark dark:brightness-[1.35] dark:ring-1 dark:hover:brightness-150 bg-white ring-1 ring-gray-400/30 dark:ring-gray-700/25 hover:ring-gray-400/60 dark:hover:ring-white/20 group-focus/link:border-2 group-focus/link:border-primary dark:group-focus/link:border-primary-light"><svg aria-hidden="true" width="18" height="18" stroke-width="2" class="size-3 shrink-0"><use href="#mi-mint-1-Link"></use></svg></div></a></div><span id="_R_l5deehkd74t9_" class="cursor-pointer">Usage example</span></h2>
<span data-as="p">The following example shows how you can use a 1Password JavaScript SDK client to call a function that fetches your OIDC token, then uses it alongside the other required variables to retrieve secrets from your Environment in a <a href="https://docs.gitlab.com/ci/jobs/" target="_blank" rel="noreferrer" class="link">GitLab CI/CD job.</a></span>
<div class="tabs tabs tab-container"><ul role="tablist" class="not-prose mb-6 pb-[1px] flex-none min-w-full overflow-auto border-b border-gray-200 gap-x-6 flex dark:border-gray-200/10" data-component-part="tabs-list"><li id="1password-sdk-client-example" role="tab" aria-selected="true" aria-controls="panel-1password-sdk-client-example-0" tabindex="0" class="cursor-pointer"><div class="flex text-sm items-center gap-1.5 leading-6 font-semibold whitespace-nowrap pt-3 pb-2.5 -mb-px max-w-max border-b text-primary dark:text-primary-light border-current" data-component-part="tab-button" data-active="true" data-testid="tab-1Password SDK client example"> <!-- -->1Password SDK client example</div></li><li id="gitlab-ci%2Fcd-job-example" role="tab" aria-selected="false" aria-controls="panel-gitlab-ci%2Fcd-job-example-1" tabindex="-1" class="cursor-pointer"><div class="flex text-sm items-center gap-1.5 leading-6 font-semibold whitespace-nowrap pt-3 pb-2.5 -mb-px max-w-max border-b text-gray-900 border-transparent hover:border-gray-300 dark:text-gray-200 dark:hover:border-gray-700" data-component-part="tab-button" data-active="false" data-testid="tab-GitLab CI/CD job example"> <!-- -->GitLab CI/CD job example</div></li></ul><div><div id="panel-1password-sdk-client-example-0" role="tabpanel" aria-labelledby="1password-sdk-client-example" tabindex="0" class="prose dark:prose-invert overflow-x-auto [&amp;_[data-table-wrapper]]:![--page-padding:0px] [&amp;_[role=&quot;listitem&quot;]]:pl-4 -ml-4 pl-4 [&amp;&gt;:first-child:not(p)]:mt-0 [&amp;&gt;:first-child:not(p)_img]:mt-0 [&amp;&gt;:first-child[data-table-wrapper]]:pt-0!" data-component-part="tab-content"><div class="code-block mt-5 mb-8 not-prose rounded-2xl relative group min-w-0 print:print-color-exact text-gray-950 bg-gray-50 dark:bg-white/5 dark:text-gray-50 codeblock-light border border-gray-950/10 dark:border-white/10 dark:twoslash-dark p-0.5" data-has-header="" numberOfLines="57" language="javascript"><div class="flex te