 for n in 1 2 3 4 5; do
   [ "$(vec "${OUT[sh$n]}")" = "${EXPECT[sh$n]}" ] && [ "${RC[sh$n]}" = 1 ] && shims_ok=$((shims_ok+1))
 done
-pass=0
-[ "$real_ok" = 1 ] && pass=5
