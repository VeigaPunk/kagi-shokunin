<td id="S3.T1.2.5.3" class="ltx_td ltx_align_left"><span id="S3.T1.2.5.3.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">0.1</span></td></tr>
<tr id="S3.T1.2.6" class="ltx_tr">
<th id="S3.T1.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">char</th>
