<script>
	(function (){
		hum = window.hum || {};
		var tracker = {
		   options: {
		    apiKey: 'prod-key-ieee-uqaxhbhwpq',
		    contentSource: 'xplore',
		    apiUrl: 'https://ieee.hum.works/api/',
		    cookieDomain: 'ieee.org',
		    useIframeStorage: true
		   }
		};
		hum['ieee' + 'Tracker'] = tracker;
