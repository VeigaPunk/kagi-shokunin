              &lt;td align=&quot;center&quot; valign=&quot;top&quot; rowspan=&quot;1&quot; colspan=&quot;1&quot;/&gt;
            &lt;/tr&gt;
            &lt;tr&gt;
              &lt;td align=&quot;left&quot; valign=&quot;top&quot; rowspan=&quot;1&quot; colspan=&quot;1&quot;&gt;Remain (2)&lt;/td&gt;
