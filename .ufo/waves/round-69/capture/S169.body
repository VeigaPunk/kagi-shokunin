="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Designs%2C+Codes+and+Cryptography&amp;rft.atitle=Cryptocash%2C+cryptocurrencies%2C+and+cryptocontracts&amp;rft.volume=78&amp;rft.issue=1&amp;rft.pages=87-102&amp;rft.date=2016-01&amp;rft_id=info%3Adoi%2F10.1007%2Fs10623-015-0148-5&amp;rft_id=https%3A%2F%2Fapi.semanticscholar.org%2FCorpusID%3A16594958%23id-name%3DS2CID&amp;rft.aulast=Koblitz&amp;rft.aufirst=Neal&amp;rft.au=Menezes%2C+Alfred+J.&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AMerkle+tree" class="Z3988" about="#mwt29" id="mwAWo"></span></span></li>
<li about="#cite_note-11" id="cite_note-11" data-mw-footnote-number="11"><span class="mw-cite-backlink" id="mwAWs"><a href="#cite_ref-11" rel="mw:referencedBy" id="mwAWw"><span class="mw-linkback-text" id="mwAW0">↑</span></a></span> <span id="mw-reference-text-cite_note-11" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt32" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwAW4" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite journal ","href":"./Template:Cite_journal"},"params":{"url":{"wt":"https://datatracker.ietf.org/doc/draft-ietf-plants-merkle-tree-certs/"},"title":{"wt":"Merkle Tree Certificates"},"journal":{"wt":"Internet Engineering Task Force"},"publisher":{"wt":"IETF"},"access-date":{"wt":"2026-06-11"},"author1":{"wt":"D. Benjamin"},"author2":{"wt":"D. O&apos;Brien"},"author3":{"wt":"B. E. Westerbaan"},"author4":{"wt":"L. Valenta"},"author5":{"wt":"F. Valsorda"},"date":{"wt":"2026-05-24"}},"i":0}}]}'/><cite id="CITEREFD._BenjaminD._O'BrienB._E._WesterbaanL._Valenta2026" class="citation journal cs1" about="#mwt32">D. Benjamin; D. O'Brien; B. E. Westerbaan; L. Valenta; F. Valsorda (2026-05-24). <a rel="mw:ExtLink nofollow" href="https://datatracker.ietf.org/doc/draft-ietf-plants-merkle-tree-certs/" class="external text" id="mwAW8">"Merkle Tree Certificates"</a>. <i id="mwAXA">Internet Engineering Task Force</i>. IETF<span class="reference-accessdate" id="mwAXE">. Retrieved <span class="nowrap" id="mwAXI">2026-06-11</span></span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Internet+Engineering+Task+Force&amp;rft.atitle=Merkle+Tree+Certificates&amp;rft.date=2026-05-24&amp;rft.au=D.+Benjamin&amp;rft.au=D.+O%27Brien&amp;rft.au=B.+E.+Westerbaan&amp;rft.au=L.+Valenta&amp;rft.au=F.+Valsorda&amp;rft_id=https%3A%2F%2Fdatatracker.ietf.org%2Fdoc%2Fdraft-ietf-plants-merkle-tree-certs%2F&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AMerkle+tree" class="Z3988" about="#mwt32" id="mwAXM"></span></span></li>
<li about="#cite_note-12" id="cite_note-12" data-mw-footnote-number="12"><span class="mw-cite-backlink" id="mwAXQ"><a href="#cite_ref-12" rel="mw:referencedBy" id="mwAXU"><span class="mw-linkback-text" id="mwAXY">↑</span></a></span> <span id="mw-reference-text-cite_note-12" class="mw-reference-text reference-text">Dolstra, E. <a rel="mw:ExtLink nofollow" href="https://nixos.org/~eelco/pubs/phd-thesis.pdf#page21" class="external text" id="mwAXc"><i id="mwAXg">The Purely Functional Software Deployment Model.</i></a> PhD thesis, Faculty of Science, Utrecht, The Netherlands. January 2006. p.21 <link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt35" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwAXk" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"ISBN","href":"./Template:ISBN"},"params":{"1":{"wt":"90-393-4130-3"}},"i":0}}]}'/><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" about="#mwt35" class="mw-redirect" id="mwAXo">ISBN</a><span typeof="mw:Entity" about="#mwt35" id="mwAXs"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/90-393-4130-3" title="Special:BookSources/90-393-4130-3" about="#mwt35" id="mwAXw"><bdi id="mwAX0">90-393-4130-3</bdi></a>.</span></li>
<li about="#cite_note-13" id="cite_note-13" data-mw-footnote-number="13"><span class="mw-cite-backlink" id="mwAX4"><a href="#cite_ref-13" rel="mw:referencedBy" id="mwAX8"><span class="mw-linkback-text" id="mwAYA">↑</span></a></span> <span id="mw-reference-text-cite_note-13" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt38" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwAYE" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web\n ","href":"./Template:Cite_web"},"params":{"url":{"wt":"http://www.aosabook.org/en/nosql.html"},"title":{"wt":"The NoSQL Ecosystem"},"author":{"wt":"Adam Marcus"},"website":{"wt":"aosabook.org"},"quote":{"wt":"When a replica is down for an extended period of time, or the machine storing hinted handoffs for an unavailable replica goes down as well, replicas must synchronize from one another. In this case, Cassandra and Riak implement a Dynamo-inspired process called anti-entropy. In anti-entropy, replicas exchange Merkle trees to identify parts of their replicated key ranges which are out of sync. A Merkle tree is a hierarchical hash verification: if the hash over the entire keyspace is not the same between two replicas, they will exchange hashes of smaller and smaller portions of the replicated keyspace until the out-of-sync keys are identified. This approach reduces unnecessary data transfer between replicas which contain mostly similar data."}},"i":0}}]}'/><cite id="CITEREFAdam_Marcus" class="citation web cs1" about="#mwt38">Adam Marcus. <a rel="mw:ExtLink nofollow" href="http://www.aosabook.org/en/nosql.html" class="external text" id="mwAYI">"The NoSQL Ecosystem"</a>. <i id="mwAYM">aosabook.org</i>. <q id="mwAYQ">When a replica is down for an extended period of time, or the machine storing hinted handoffs for an unavailable replica goes down as well, replicas must synchronize from one another. In this case, Cassandra and Riak implement a Dynamo-inspired process called anti-entropy. In anti-entropy, replicas exchange Merkle trees to identify parts of their replicated key ranges which are out of sync. A Merkle tree is a hierarchical hash verification: if the hash over the entire keyspace is not the same between two replicas, they will exchange hashes of smaller and smaller portions of the replicated keyspace until the out-of-sync keys are identified. This approach reduces unnecessary data transfer between replicas which contain mostly similar data.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=aosabook.org&amp;rft.atitle=The+NoSQL+Ecosystem&amp;rft.au=Adam+Marcus&amp;rft_id=http%3A%2F%2Fwww.aosabook.org%2Fen%2Fnosql.html&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AMerkle+tree" class="Z3988" about="#mwt38" id="mwAYU"></span></span></li>
<li about="#cite_note-14" id="cite_note-14" data-mw-footnote-number="14"><span class="mw-cite-backlink" id="mwAYY"><a href="#cite_ref-14" rel="mw:referencedBy" id="mwAYc"><span class="mw-linkback-text" id="mwAYg">↑</span></a></span> <span id="mw-reference-text-cite_note-14" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt41" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwAYk" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite book ","href":"./Template:Cite_book"},"params":{"last":{"wt":"Kilian"},"first":{"wt":"J."},"title":{"wt":"Advances in Cryptology — CRYPT0&apos; 95"},"chapter":{"wt":"Improved Efficient Arguments"},"series":{"wt":"Lecture Notes in Computer Science"},"date":{"wt":"1995"},"volume":{"wt":"963"},"pages":{"wt":"311–324"},"chapter-url":{"wt":"https://link.springer.com/content/pdf/10.1007/3-540-44750-4_25.pdf"},"doi":{"wt":"10.1007/3-540-44750-4_25"},"doi-access":{"wt":"free"},"isbn":{"wt":"978-3-540-60221-7"}},"i":0}}]}'/><cite id="CITEREFKilian1995" class="citation book cs1" about="#mwt41">Kilian, J. (1995). <a rel="mw:ExtLink nofollow" href="https://link.springer.com/content/pdf/10.1007/3-540-44750-4_25.pdf" class="external text" id="mwAYo">"Improved Efficient Arguments"</a> <span class="cs1-format" id="mwAYs">(PDF)</span>. <i id="mwAYw">Advances in Cryptology — CRYPT0' 95</i>. Lecture Notes in Computer Science. Vol.<span typeof="mw:Entity" id="mwAY0"> </span>963. pp.<span typeof="mw:Entity" id="mwAY4"> </span><span class="nowrap" id="mwAY8">311–</span>324. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwAZA">doi</a>:<span class="id-lock-free" title="Freely accessible" id="mwAZE"><a rel="mw:ExtLink nofollow" href="https://doi.org/10.1007%2F3-540-44750-4_25" class="external text" id="mwAZI">10.1007/3-540-44750-4_25</a></span>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwAZM">ISBN</a><span typeof="mw:Entity" id="mwAZQ"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/978-3-540-60221-7" title="Special:BookSources/978-3-540-60221-7" id="mwAZU"><bdi id="mwAZY">978-3-540-60221-7</bdi></a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=bookitem&amp;rft.atitle=Improved+Efficient+Arguments&amp;rft.btitle=Advances+in+Cryptology+%E2%80%94+CRYPT0%27+95&amp;rft.series=Lecture+Notes+in+Computer+Science&amp;rft.pages=311-324&amp;rft.date=1995&amp;rft_id=info%3Adoi%2F10.1007%2F3-540-44750-4_25&amp;rft.isbn=978-3-540-60221-7&amp;rft.aulast=Kilian&amp;rft.aufirst=J.&amp;rft_id=https%3A%2F%2Flink.springer.com%2Fcontent%2Fpdf%2F10.1007%2F3-540-44750-4_25.pdf&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AMerkle+tree" class="Z3988" about="#mwt41" id="mwAZc"></span></span></li>
<li about="#cite_note-:0-15" id="cite_note-:0-15" data-mw-footnote-number="15"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwAZg"><a href="#cite_ref-:0_15-0" id="mwAZk"><span class="mw-linkback-text" id="mwAZo">1</span></a> <a href="#cite_ref-:0_15-1" id="mwAZs"><span class="mw-linkback-text" id="mwAZw">2</span></a></span> <span id="mw-reference-text-cite_note-:0-15" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt44" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwAZ0" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite journal","href":"./Template:Cite_journal"},"params":{"last1":{"wt":"Laurie"},"first1":{"wt":"B."},"last2":{"wt":"Langley"},"first2":{"wt":"A."},"last3":{"wt":"Kasper"},"first3":{"wt":"E."},"date":{"wt":"June 2013"},"title":{"wt":"Certificate Transparency"},"url":{"wt":"https://www.rfc-editor.org/info/rfc6962"},"journal":{"wt":"IETF"},"language":{"wt":"en"},"article-number":{"wt":"RFC6962"},"doi":{"wt":"10.17487/rfc6962"},"doi-access":{"wt":""},"url-access":{"wt":"subscription"}},"i":0}}]}'/><cite id="CITEREFLaurieLangleyKasper2013" class="citation journal cs1" about="#mwt44">Laurie, B.; Langley, A.; Kasper, E. (June 2013). <span class="id-lock-subscription" title="Paid subscription required" id="mwAZ4"><a rel="mw:ExtLink nofollow" href="https://www.rfc-editor.org/info/rfc6962" class="external text" id="mwAZ8">"Certificate Transparency"</a></span>. <i id="mwAaA">IETF</i> RFC6962. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwAaE">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.17487%2Frfc6962" class="external text" id="mwAaI">10.17487/rfc6962</a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=ar