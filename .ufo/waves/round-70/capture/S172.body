</span><span class="line-of-code__mDztA line-highlight-first__OMDUP line-highlight-last__qC6nm"><span class="line"><span>    &quot;delta_crl_distribution_points&quot;: [&quot;&lt;url1&gt;&quot;, &quot;&lt;url2&gt;&quot;]</span></span>
</span><span class="line-of-code__mDztA line-highlight-first__OMDUP line-highlight-last__qC6nm"><span class="line"><span>    &quot;ocsp_servers&quot;: [&quot;&lt;url1&gt;&quot;, &quot;&lt;url2&gt;&quot;]</span></span>
