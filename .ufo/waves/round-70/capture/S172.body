</span><span class="line-of-code__mDztA line-highlight-first__OMDUP line-highlight-last__qC6nm"><span class="line"><span style="color:var(--code-block-color-keyword)">  &quot;auto_rebuild&quot;</span><span style="color:var(--code-block-color-punctuation)">:</span><span style="color:var(--code-block-color-string)"> &quot;true&quot;</span><span style="color:var(--code-block-color-punctuation)">,</span></span>
</span><span class="line-of-code__mDztA line-highlight-first__OMDUP line-highlight-last__qC6nm"><span class="line"><span style="color:var(--code-block-color-keyword)">  &quot;auto_rebuild_grace_period&quot;</span><span style="color:var(--code-block-color-punctuation)">:</span><span style="color:var(--code-block-color-string)"> &quot;8h&quot;</span><span style="color:var(--code-block-color-punctuation)">,</span></span>
</span><span class="line-of-code__mDztA line-highlight-first__OMDUP line-highlight-last__qC6nm"><span class="line"><span style="color:var(--code-block-color-keyword)">  &quot;enable_delta&quot;</span><span style="color:var(--code-block-color-punctuation)">:</span><span style="color:var(--code-block-color-string)"> &quot;true&quot;</span><span style="color:var(--code-block-color-punctuation)">,</span></span>
</span><span class="line-of-code__mDztA line-highlight-first__OMDUP line-highlight-last__qC6nm"><span class="line"><span style="color:var(--code-block-color-keyword)">  &quot;delta_rebuild_interval&quot;</span><span style="color:var(--code-block-color-punctuation)">:</span><span style="color:var(--code-block-color-string)"> &quot;10m&quot;</span><span style="color:var(--code-block-color-punctuation)">,</span></span>
</span><span class="line-of-code__mDztA line-highlight-first__OMDUP line-highlight-last__qC6nm"><span class="line"><span style="color:var(--code-block-color-keyword)">  &quot;cross_cluster_revocation&quot;</span><span style="color:var(--code-block-color-punctuation)">:</span><span style="color:var(--code-block-color-constant)"> true</span><span style="color:var(--code-block-color-punctuation)">,</span></span>
</span><span class="line-of-code__mDztA line-highlight-first__OMDUP line-highlight-last__qC6nm"><span class="line"><span style="color:var(--code-block-color-keyword)">  &quot;unified_crl&quot;</span><span style="color:var(--code-block-color-punctuation)">:</span><span style="color:var(--code-block-color-constant)"> true</span><span style="color:var(--code-block-color-punctuation)">,</span></span>
</span><span class="line-of-code__mDztA line-highlight-first__OMDUP line-highlight-last__qC6nm"><span class="line"><span style="color:var(--code-block-color-keyword)">  &quot;unified_crl_on_existing_paths&quot;</span><span style="color:var(--code-block-color-punctuation)">:</span><span style="color:var(--code-block-color-constant)"> true</span><span style="color:var(--code-block-color-punctuation)">,</span></span>
