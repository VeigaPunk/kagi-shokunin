</span><span class="line-of-code__mDztA line-highlight-first__OMDUP line-highlight-last__qC6nm"><span class="line"><span style="color:var(--code-block-color-keyword)">    &quot;export_key_hmac&quot;</span><span style="color:var(--code-block-color-punctuation)">:</span><span style="color:var(--code-block-color-string)"> &quot;sha256:a665a45920422f9d417e4867efdc4fb8a04a1f3fff1fa07e998e86f7f7a27ae3&quot;</span><span style="color:var(--code-block-color-punctuation)">,</span></span>
