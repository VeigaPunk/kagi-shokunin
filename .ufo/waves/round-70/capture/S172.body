rst__OMDUP line-highlight-last__qC6nm"><span class="line"><span style="color:var(--code-block-color-cyan)">$</span><span style="color:var(--code-block-color-token)"> base64 --decode </span><span style="color:var(--code-block-color-keyword)">&lt;&lt;&lt;</span><span style="color:var(--code-block-color-string)"> $(</span><span style="color:var(--code-block-color-function)">vault</span><span style="color:var(--code-block-color-token)"> read --field=cert_metadata pki/cert-metadata/67:b4:f7:2c:aa:ef:b9:30:f6:ae:f5:12:21:79:ac:08:8a:86:89:72 )</span></span>
