</span><span class="line-of-code__mDztA line-highlight-first__OMDUP line-highlight-last__qC6nm"><span>    "external_service_last_updated": "0001-01-01T00:00:00Z",</span>
</span><span class="line-of-code__mDztA line-highlight-first__OMDUP line-highlight-last__qC6nm"><span>    "external_service_url": "",</span>
</span><span class="line-of-code__mDztA line-highlight-first__OMDUP line-highlight-last__qC6nm"><span>    "external_service_validated": false,</span>
</span><span class="line-of-code__mDztA line-highlight-first__OMDUP line-highlight-last__qC6nm"><span>    "last_successful_request": "",</span>
