+   && q write pki/roles/t6 allowed_domains=r71.test allow_subdomains=true max_ttl=48h; then
+  if bao write -format=json pki/issuer/r71short/issue/t6 common_name=t.r71.test ttl=30h >"$S/t6.json" 2>/dev/null; then
     jget "$S/t6.json" certificate > "$S/t6.pem"
     le=$(endsec "$S/t6.pem"); ie=$(endsec "$S/short.pem")
     ev "$S/t6.pem" t6-leaf.pem; ev "$S/short.pem" t6-issuer.pem
